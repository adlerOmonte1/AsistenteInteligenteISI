# Copie este archivo como .env y complete los valores. Nunca suba el .env al repositorio.
# docs/05-despliegue/guia_despliegue.md explica cada variable.

# --- Dominio ----------------------------------------------------------------
# Subdominio asignado por el Centro de Cómputo (marcador hasta confirmarlo)
DOMINIO=asistente.example.edu.pe

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_ALLOWED_HOSTS=asistente.example.edu.pe
CSRF_TRUSTED_ORIGINS=https://asistente.example.edu.pe
# Dominios que insertan el widget <udh-chat> (separados por coma)
CORS_ALLOWED_ORIGINS=https://asistente.example.edu.pe,https://www.udh.edu.pe
LOG_LEVEL=INFO

# --- Base de datos ----------------------------------------------------------
POSTGRES_DB=asistente
POSTGRES_USER=asistente
POSTGRES_PASSWORD=cambie-esta-clave
DATABASE_URL=postgres://asistente:cambie-esta-clave@db:5432/asistente

# --- Modelo de lenguaje -----------------------------------------------------
# local   → sin red ni costo: respuestas extractivas (desarrollo y respaldo)
# gemini  → Google AI Studio (https://aistudio.google.com/apikey)
# openai  → cualquier API compatible con OpenAI (OpenAI, DeepSeek, Groq...); defina LLM_URL_BASE
LLM_PROVEEDOR=gemini
LLM_MODELO=gemini-2.5-flash-lite
LLM_API_KEY=
LLM_URL_BASE=
# Precios en USD por millón de tokens; se usan para estimar el gasto del mes
LLM_PRECIO_ENTRADA_MILLON=0.10
LLM_PRECIO_SALIDA_MILLON=0.40

# Embeddings: si cambia el proveedor o el modelo, ejecute `manage.py reindexar`
EMBED_PROVEEDOR=gemini
EMBED_MODELO=gemini-embedding-001
# Si se deja vacío, se usa LLM_API_KEY
EMBED_API_KEY=
EMBED_PRECIO_MILLON=0.15

# Tope interno de gasto mensual (también editable desde el panel)
LIMITE_USD_MES=8

# --- Límites del chat -------------------------------------------------------
LIMITE_MENSAJES_SESION_HORA=30
LIMITE_MENSAJES_IP_HORA=300

# --- Solo desarrollo --------------------------------------------------------
# Contraseña de las cuentas demo-centro, demo-revisor, demo-editor y demo-lector
# que crea `manage.py crear_usuarios_demo` (solo con DEBUG=True).
DEMO_PASSWORD=Demo-UDH-2026
