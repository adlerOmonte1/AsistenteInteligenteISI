# Plantilla procesada por la imagen oficial de Nginx (envsubst): ${DOMINIO} sale del entorno.
# Rutas:
#   /            portal público (SPA)
#   /admin/      panel de administración (SPA)
#   /widget/     <udh-chat> para insertar en otras páginas
#   /api/        API Django (gunicorn)
#   /media/      documentos subidos desde el panel

limit_req_zone $binary_remote_addr zone=chat:10m rate=30r/m;

server {
    listen 80;
    server_name ${DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 11m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /api/v1/chat/ {
        limit_req zone=chat burst=10 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE: sin búfer para que los eventos lleguen apenas se emiten
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /media/ {
        alias /app/media/;
        add_header X-Content-Type-Options nosniff always;
    }

    location /widget/ {
        alias /usr/share/nginx/widget/;
        add_header Cache-Control "public, max-age=3600";
        add_header Access-Control-Allow-Origin "*";
    }

    location /admin/ {
        root /usr/share/nginx;
        try_files $uri $uri/ /admin/index.html;
        add_header X-Frame-Options DENY always;
    }

    location / {
        root /usr/share/nginx/portal;
        try_files $uri $uri/ /index.html;
    }
}
