# Variables para desarrollo local. Copie este archivo como backend/.env (no se sube al repositorio).
# Guía: docs/04-desarrollo/guia_gemini.md

# Gemini con el plan gratuito de Google AI Studio
LLM_PROVEEDOR=gemini
LLM_MODELO=gemini-2.5-flash-lite
LLM_API_KEY=pegue-aqui-su-clave
EMBED_PROVEEDOR=gemini
EMBED_MODELO=gemini-embedding-001

# Para volver al modo local (sin red ni clave), comente las líneas anteriores o use:
# LLM_PROVEEDOR=local
# EMBED_PROVEEDOR=local
